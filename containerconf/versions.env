# Toolchain pins for the xpal-claudia image. Committed on purpose (unlike .env,
# which is machine-specific). build.sh and config.sh source this file;
# build.sh passes each value to the Containerfile as a --build-arg, and the
# Containerfile refuses to build if one is missing.
#
# Every value can be overridden for one build without editing this file:
#   CLAUDE_CODE_VERSION=2.2.0 ./build.sh
# To bump a pin: edit it here, run ./build.sh, and read the version list it
# prints at the end (also in the image at /etc/xpal-versions). See ADR-009.
#
# Deliberately NOT pinned: Debian apt packages (git, curl, ripgrep, zsh, jq,
# openssh-client). The base image digest below fixes the Debian snapshot they
# come from; their exact versions are recorded in /etc/xpal-apt-manifest.

# Base image, by digest (multi-arch index: amd64 + arm64). The tag is kept for
# humans; the digest is what is actually pulled. To refresh, resolve the
# current digest for the tag (e.g. `skopeo inspect --raw docker://<tag>` or the
# registry's manifest endpoint) and replace it, then rebuild.
DEBIAN_IMAGE="${DEBIAN_IMAGE:-docker.io/library/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3}"

# Node.js major (NodeSource). Minor/patch float within the major. Node 20 is the
# floor required by the projects under /xpal-src (see ADR-009).
NODE_MAJOR="${NODE_MAJOR:-20}"

# npm CLIs, installed globally.
CLAUDE_CODE_VERSION="${CLAUDE_CODE_VERSION:-2.1.312}"
OPENCODE_VERSION="${OPENCODE_VERSION:-1.19.5}"

# GitHub CLI — release tarball, verified against the published checksums.
GH_VERSION="${GH_VERSION:-2.96.0}"

# Python toolchain (uv owns Python; there is intentionally no apt python3).
UV_VERSION="${UV_VERSION:-0.11.29}"
PYTHON_VERSION="${PYTHON_VERSION:-3.13}"
IPYTHON_VERSION="${IPYTHON_VERSION:-9.15.0}"

# oh-my-zsh has no release tags, so it is pinned to a commit.
OH_MY_ZSH_REF="${OH_MY_ZSH_REF:-17a2b4c3a5855524ad4772a17ada0dc474e2fdf3}"

# UID of the optional `coder` fallback user (see ADR-008). Fixed, not tied to
# the host. Also read by config.sh for XPAL_AS_CODER runs.
CODER_UID="${CODER_UID:-1000}"
